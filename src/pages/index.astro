---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/url';
---

<Layout
  title="Perfect Forms – Figurstudio Winterthur"
  description="Figurmodellierung mit Abnehmen, Hautstraffung und Muskelaufbau in Winterthur. Infrarot in Verbindung mit Bewegung. Probetraining Fr 30.-"
  currentPath="/"
>
  <!-- SECTION 1: HERO WITH PARALLAX -->
  <section class="hero-wrapper">
    <div class="container--wide">
      <div class="hero-card">
        <div class="hero-card-media" aria-hidden="true">
          <img
            class="hero-bg-img"
            id="heroParallaxImg"
            src={withBase('/Images/hero-bg.webp')}
            alt=""
            width="1024"
            height="538"
            fetchpriority="high"
          />
          <div class="hero-card-overlay"></div>
        </div>

        <div class="hero-card-inner">
          <div class="hero-text-wrapper hero-intro-card">
            <span class="hero-greeting hero-intro-item" style="--hero-delay: 0.8s;">Ihr persönliches Figurstudio</span>
            <h1 class="hero-title hero-intro-item" style="--hero-delay: 0.92s;">
              Abnehmen <span class="hero-highlight">ohne Anstrengung</span> in Winterthur
            </h1>
            <p class="hero-subtitle hero-intro-item" style="--hero-delay: 1.06s;">
              Figurmodellierung mit Abnehmen, Hautstraffung und Muskelaufbau in Winterthur. Infrarotwärme in
              Verbindung mit gezielter, rückenschonender Bewegung am SUN 400 XL.
            </p>

            <div class="hero-actions hero-intro-item" style="--hero-delay: 1.18s;">
              <a href={withBase('/kontakt')} class="btn-primary btn-lg">Probetraining Fr 30.-</a>
              <a href={withBase('/sun400xl')} class="hero-secondary-link">
                Das SUN 400 XL entdecken
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: GOALS 3-CARD CAROUSEL -->
  <section class="section" id="vorteile">
    <div class="container">
      <div class="section-head--split reveal-up">
        <h2 class="section-title">
          Was ist Ihr<br />
          Figur- &amp; Wohlfühlziel?
        </h2>
        <div class="slider-controls" aria-label="Ziele durchblättern">
          <button type="button" class="slider-btn" id="goalsPrev" aria-label="Vorheriges Ziel">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5" />
              <path d="m12 19-7-7 7-7" />
            </svg>
          </button>
          <button type="button" class="slider-btn" id="goalsNext" aria-label="Nächstes Ziel">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

      <div class="goals-track reveal-stagger" id="goalsTrack">
        <article class="goal-card">
          <div class="goal-card-top">
            <h3>Umfangreduzierung</h3>
            <p>Gezielte Abnahme an Problemzonen wie Bauch, Beine und Po durch Tiefenwärme und sanfte Bewegung.</p>
          </div>
          <div class="goal-card-media">
            <img src={withBase('/Images/goal-umfangreduzierung.webp')} alt="Gezielte Umfangreduzierung an Bauch, Beinen und Po" width="1024" height="768" loading="lazy" />
            <a href={withBase('/sun400xl')} class="goal-card-arrow" aria-label="Mehr zur Umfangreduzierung erfahren">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </div>
        </article>

        <article class="goal-card">
          <div class="goal-card-top">
            <h3>Straffe Haut &amp; Cellulite</h3>
            <p>Verbessertes Hautbild, gesteigerte Durchblutung und effektive Rückbildung von Cellulite durch Infrarot.</p>
          </div>
          <div class="goal-card-media">
            <img src={withBase('/Images/goal-straffe-haut.webp')} alt="Straffe Haut und Rückbildung von Cellulite an Oberschenkeln und Beinen" width="1024" height="768" loading="lazy" />
            <a href={withBase('/sun400xl')} class="goal-card-arrow" aria-label="Mehr zu straffer Haut erfahren">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </div>
        </article>

        <article class="goal-card">
          <div class="goal-card-top">
            <h3>Muskelaufbau &amp; Stoffwechsel</h3>
            <p>Effektive Stärkung der Muskulatur durch Widerstand und nachhaltige Aktivierung der Fettverbrennung.</p>
          </div>
          <div class="goal-card-media">
            <img src={withBase('/Images/goal-muskelaufbau.webp')} alt="Gezielter Muskelaufbau und aktiver Stoffwechsel im Studio" width="1024" height="768" loading="lazy" />
            <a href={withBase('/sun400xl')} class="goal-card-arrow" aria-label="Mehr zu Muskelaufbau und Stoffwechsel erfahren">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </div>
        </article>

        <article class="goal-card" hidden>
          <div class="goal-card-top">
            <h3>Wellness &amp; Tiefenentspannung</h3>
            <p>Nach dem 30-Minuten-Training auf unseren Relaxliegen nachschwitzen, Stress abbauen und neue Kraft tanken.</p>
          </div>
          <div class="goal-card-media">
            <img src={withBase('/Images/goal-wellness.webp')} alt="Tiefenentspannung auf modernen Relaxliegen im Studio" width="1024" height="538" loading="lazy" />
            <a href={withBase('/das-studio')} class="goal-card-arrow" aria-label="Mehr zu Wellness im Studio erfahren">
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- SECTION 3: Z-LAYOUT ABOUT & WELLNESS -->
  <section class="section" id="wellness">
    <div class="container">
      <div class="who-grid">
        <div class="who-main-photo reveal-media" data-parallax>
          <img src={withBase('/Images/asd.jpg')} alt="Entspannung und Wellness im Perfect Forms Studio" width="3104" height="1312" loading="lazy" />
        </div>

        <div class="who-copy reveal-stagger">
          <span class="section-eyebrow">Über Perfect Forms</span>
          <h2 class="section-title">
            Sichtbare Resultate<br />
            garantiert
          </h2>
          <p class="section-desc">
            Durch die einzigartige Kombination von gezielter Bewegung und therapeutischer Infrarotwärme im SUN 400 XL
            erreichen Sie Ihre Ziele schneller und effektiver als bei herkömmlichem Training – persönlich begleitet in
            unserer Wohlfühloase in Winterthur.
          </p>
          <a href={withBase('/das-studio')} class="btn-primary">Das Studio entdecken</a>
        </div>

        <div class="who-copy who-copy--bottom reveal-stagger">
          <span class="section-eyebrow">Ganzheitliche Entspannung</span>
          <h2 class="section-title">
            Wohlbefinden für<br />
            Körper &amp; Geist
          </h2>
          <p class="section-desc">
            Geniessen Sie Tiefenentspannung, reduzieren Sie Stresshormone und verbessern Sie Ihre Schlafqualität – ganz
            ohne Belastung für den Rücken und persönlich begleitet durch Inhaberin Jeanna Gloor.
          </p>
          <a href={withBase('/kontakt')} class="btn-primary">Probetraining buchen</a>
        </div>

        <div class="who-main-photo reveal-media" data-parallax>
          <img src={withBase('/Images/wellness-wohlbefinden.webp')} alt="Wohlbefinden für Körper und Geist" width="1024" height="768" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: MISSION SPLIT BANNER -->
  <section class="section" style="padding-top: 1rem;">
    <div class="container--wide">
      <div class="mission-banner reveal-scale">
        <div class="mission-media" data-parallax>
          <img src={withBase('/Images/studio-relax-hq.webp')} alt="Ruhebereich mit Relaxliegen im Perfect Forms Studio Winterthur" width="1200" height="650" loading="lazy" />
        </div>

        <div class="mission-content reveal-stagger">
          <blockquote class="mission-quote">
            Transformieren Sie Körper, Geist und Leben – in unserer entspannten Wohlfühlatmosphäre.
          </blockquote>
          <p class="mission-author">— Jeanna Gloor, Inhaberin Perfect Forms Winterthur</p>

          <div class="mission-actions-row">
            <span class="mission-actions-label">Direkt erreichen:</span>
            <a href="tel:+41763833318" class="mission-icon-btn" aria-label="Anrufen: 076 383 33 18" title="076 383 33 18">
              <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </a>
            <a href={withBase('/kontakt')} class="mission-icon-btn" aria-label="Standort &amp; Anfahrt" title="Rychenbergstrasse 67, Winterthur">
              <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </a>
            <a href={withBase('/preise')} class="mission-icon-btn" aria-label="Preise &amp; Abonnemente" title="Preise &amp; Abonnemente">
              <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4" />
                <path d="M4 6v12c0 1.1.9 2 2 2h14v-4" />
                <path d="M18 12a2 2 0 0 0-2 2c0 1.1.9 2 2 2h4v-4h-4z" />
              </svg>
            </a>
            <a href={withBase('/sun400xl')} class="mission-icon-btn" aria-label="Das SUN 400 XL" title="Das SUN 400 XL">
              <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5" />
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5: HOW IT WORKS (SO FUNKTIONIERT'S) -->
  <section class="section" id="ablauf">
    <div class="container">
      <div class="section-head reveal-stagger">
        <span class="section-label">So funktioniert’s</span>
        <h2 class="section-title">So läuft Ihr erster Besuch ab</h2>
        <p class="section-desc">
          Unkompliziert, rückenschonend und unverbindlich – in rund 30 Minuten am SUN 400 XL.
        </p>
      </div>

      <ol class="steps-grid reveal-stagger">
        <li class="step-card">
          <div class="step-card-head">
            <span class="step-num" aria-hidden="true">01</span>
            <span class="step-tag">Unverbindlich</span>
          </div>
          <h3>Termin vereinbaren</h3>
          <p>
            Rufen Sie an oder senden Sie uns eine kurze Anfrage. Termine sind auch nach 18 Uhr und am Wochenende
            möglich – Probetraining nur Fr 30.-.
          </p>
        </li>

        <li class="step-card">
          <div class="step-card-head">
            <span class="step-num" aria-hidden="true">02</span>
            <span class="step-tag">30 Minuten</span>
          </div>
          <h3>Entspannt trainieren</h3>
          <p>
            Sie trainieren rückenschonend am SUN 400 XL bei angenehmer Infrarotwärme und Entspannungsvideos –
            persönlich begleitet von Jeanna Gloor.
          </p>
        </li>

        <li class="step-card">
          <div class="step-card-head">
            <span class="step-num" aria-hidden="true">03</span>
            <span class="step-tag">Wellness</span>
          </div>
          <h3>Duschen &amp; regenerieren</h3>
          <p>
            Nach dem Workout warten unsere Relaxliegen zum Nachschwitzen, getrennte Duschkabinen sowie Schminktisch
            und Haarfön auf Sie.
          </p>
        </li>
      </ol>

      <div class="steps-foot reveal-scale">
        <div class="steps-foot-copy">
          <strong>Bitte mitbringen:</strong> 2 grosse Badetücher, langärmlige Trainingsbekleidung (keine Baumwolle!),
          2 Paar Socken, Duschsandalen &amp; Wasserflasche.
        </div>
        <a href="#kontakt" class="btn-primary">Probetraining anfragen</a>
      </div>
    </div>
  </section>

  <!-- SECTION 6: TWO-TIER PACKAGES / PRICING GRID -->
  <section class="section" id="preise">
    <div class="container">
      <div class="section-head reveal-stagger">
        <span class="section-label">Preise &amp; Abos</span>
        <h2 class="section-title">Investieren Sie in Ihre Gesundheit</h2>
        <p class="section-desc">
          Flexible Modelle für jeden Bedarf. Starten Sie mit einem unverbindlichen Probetraining für Fr 30.- (wird bei
          Abo-Kauf innert 10 Tagen zurückerstattet).
        </p>
      </div>

      <div class="pricing-grid reveal-stagger">
        <div class="fit-price-col">
          <div class="fit-price-top">
            <div class="fit-price-header">
              <h3 class="price-title">10er Abo</h3>
            </div>
            <div class="price-amount"><small>CHF</small>490</div>
            <p class="price-desc">Für den Einstieg · CHF 440.- für Studenten &amp; Senioren</p>
            <a href={withBase('/kontakt')} class="btn-outline btn-block" aria-label="10er Abo anfragen">10er Abo anfragen</a>
          </div>
          <div class="fit-price-features">
            <div class="fit-price-features-label">Inklusive Leistungen:</div>
            <ul class="fit-check-list">
              <li class="highlight">+ 1 Training Gratis (11 Trainings total)</li>
              <li>Gültigkeit 6 Monate</li>
              <li>10% Studenten- &amp; Seniorenrabatt</li>
              <li>Persönliche Betreuung durch Jeanna Gloor</li>
              <li>Nutzung von Relaxbereich &amp; Duschen</li>
              <li>Probetraining Fr 30.- wird angerechnet</li>
            </ul>
          </div>
        </div>

        <div class="fit-price-col fit-price-col--featured">
          <div class="fit-price-top">
            <div class="fit-price-header">
              <h3 class="price-title">15er Abo</h3>
              <span class="badge-bestseller">Empfohlen</span>
            </div>
            <div class="price-amount"><small>CHF</small>735</div>
            <p class="price-desc">Der Bestseller · CHF 660.- für Studenten &amp; Senioren</p>
            <a href={withBase('/kontakt')} class="btn-primary btn-block" aria-label="15er Abo anfragen">15er Abo anfragen</a>
          </div>
          <div class="fit-price-features">
            <div class="fit-price-features-label">Inklusive Leistungen:</div>
            <ul class="fit-check-list">
              <li class="highlight">+ 3 Trainings Gratis (18 Trainings total)</li>
              <li>Gültigkeit 9 Monate</li>
              <li>10% Studenten- &amp; Seniorenrabatt</li>
              <li>Persönliche Betreuung durch Jeanna Gloor</li>
              <li>Nutzung von Relaxbereich &amp; Duschen</li>
              <li>Probetraining Fr 30.- wird angerechnet</li>
            </ul>
          </div>
        </div>

        <div class="fit-price-col">
          <div class="fit-price-top">
            <div class="fit-price-header">
              <h3 class="price-title">20er Abo</h3>
            </div>
            <div class="price-amount"><small>CHF</small>980</div>
            <p class="price-desc">Maximaler Profit · CHF 880.- für Studenten &amp; Senioren</p>
            <a href={withBase('/kontakt')} class="btn-outline btn-block" aria-label="20er Abo anfragen">20er Abo anfragen</a>
          </div>
          <div class="fit-price-features">
            <div class="fit-price-features-label">Inklusive Leistungen:</div>
            <ul class="fit-check-list">
              <li class="highlight">+ 5 Trainings Gratis (25 Trainings total)</li>
              <li>Gültigkeit 1 Jahr (12 Monate)</li>
              <li>10% Studenten- &amp; Seniorenrabatt</li>
              <li>Persönliche Betreuung durch Jeanna Gloor</li>
              <li>Nutzung von Relaxbereich &amp; Duschen</li>
              <li>Probetraining Fr 30.- wird angerechnet</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="text-center reveal-up">
        <a href={withBase('/preise')} class="link-arrow">
          Einzeltraining, Studentenrabatt &amp; alle Preisdetails ansehen
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 7: EDITORIAL AUTO-PLAYING STUDIO SHOWCASE -->
  <section class="section" id="studio-einblicke" style="padding-top: 1.5rem;">
    <div class="container--wide">
      <div class="studio-showcase-head reveal-stagger">
        <h2 class="section-title studio-showcase-title">
          Einblicke in unser<br />
          Figurstudio &amp; Ausstattung
        </h2>
        <div class="studio-showcase-intro">
          <p>
            Drei moderne SUN 400 XL Kabinen, ergonomische Relaxliegen und eine persönliche Wohlfühlatmosphäre – ganz
            ohne Hektik im 1. Stock der Brauerei 67 in Winterthur.
          </p>
          <a href={withBase('/das-studio')} class="studio-showcase-link">
            <span>Alle Impressionen ansehen</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="studio-showcase-stage reveal-scale" id="studioShowcase" role="region" aria-label="Studio Impressionen">
        <div class="studio-showcase-slides">
          <img class="studio-showcase-img active" src={withBase('/Images/hero-slide-1.webp')} alt="Perfect Forms Studio Winterthur Übersicht" width="1024" height="538" loading="lazy" />
          <img class="studio-showcase-img" src={withBase('/Images/hero-slide-2.webp')} alt="Training am SUN 400 XL mit Infrarotwärme" width="1024" height="512" loading="lazy" />
          <img class="studio-showcase-img" src={withBase('/Images/hero-slide-3.webp')} alt="Relaxliegen zum Nachschwitzen und Entspannen" width="1024" height="538" loading="lazy" />
          <img class="studio-showcase-img" src={withBase('/Images/hero-slide-4.webp')} alt="Grosszügiger Ruhebereich im Studio" width="1024" height="538" loading="lazy" />
          <img class="studio-showcase-img" src={withBase('/Images/hero-slide-5.webp')} alt="Gemütliche Lounge und Wartebereich" width="1024" height="538" loading="lazy" />
        </div>

        <div class="studio-showcase-scrim" aria-hidden="true"></div>

        <div class="studio-showcase-overlay">
          <div class="studio-showcase-captions">
            <div class="studio-showcase-caption active">
              <h3>Willkommen im Studio</h3>
              <p>Ihr persönlicher Rückzugsort in Winterthur, an dem Sie sich entspannen, erholen und ganz ohne Leistungsdruck an Ihrer Figur arbeiten können.</p>
              <span class="studio-showcase-meta">1. Stock, Brauerei 67 &middot; Persönliche Betreuung durch Jeanna Gloor</span>
            </div>
            <div class="studio-showcase-caption">
              <h3>Training am SUN 400 XL</h3>
              <p>Drei moderne Infrarot-Trainingskabinen verbinden wohltuende Tiefenwärme mit rückenschonender Bewegung und entspannenden Videos.</p>
              <span class="studio-showcase-meta">30 Minuten &middot; Schonend für Rücken &amp; Gelenke</span>
            </div>
            <div class="studio-showcase-caption">
              <h3>Nachschwitzen &amp; Entspannen</h3>
              <p>Auf unseren ergonomischen Relaxliegen lassen Sie die Infrarotwärme in aller Ruhe nachwirken, bauen Stress ab und tanken neue Energie.</p>
              <span class="studio-showcase-meta">Ruhezone &middot; Tiefenentspannung &amp; Regeneration</span>
            </div>
            <div class="studio-showcase-caption">
              <h3>Wohlfühlatmosphäre</h3>
              <p>Helle Räume, frische Pflanzen, getrennte Duschkabinen und ein Schminktisch mit Haarfön sorgen dafür, dass Sie frisch in den Tag starten.</p>
              <span class="studio-showcase-meta">Komplett ausgestattet &middot; Spinde, Duschen &amp; Styling</span>
            </div>
            <div class="studio-showcase-caption">
              <h3>Ankommen &amp; Verweilen</h3>
              <p>Unsere gemütliche Lounge lädt zum entspannten Ankommen ein – auch Begleitpersonen fühlen sich hier rundum wohl.</p>
              <span class="studio-showcase-meta">Lounge &amp; Wartebereich &middot; Ruhiges Ambiente</span>
            </div>
          </div>

          <div class="studio-showcase-thumbs" role="tablist" aria-label="Studio Bereiche auswählen">
            <button type="button" class="studio-thumb active" role="tab" aria-selected="true" data-slide="0">
              <span class="studio-thumb-img">
