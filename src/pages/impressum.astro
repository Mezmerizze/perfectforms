---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Impressum – Perfect Forms"
  description="Seitenimpressum von Perfect Forms Studio Winterthur – RGQ-Consulting GmbH, Zinsikerstrasse 20, 8404 Winterthur."
  currentPath="/impressum"
>
  <section class="page-hero reveal-stagger">
    <span class="section-label">Rechtliches</span>
    <h1 class="page-title">Impressum</h1>
    <p class="page-subtitle">Seitenimpressum und Angaben zum Betreiber.</p>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container" style="max-width: 780px;">
      <div class="prose reveal-stagger" style="max-width: none;">
        <h2 class="card-title">Seitenimpressum</h2>
        <p style="max-width: none;">
          Verantwortlich für den Inhalt zeichnet sich das <strong>RGQ-Consulting GmbH</strong> | Zinsikerstrasse 20 |
          8404 Winterthur.
        </p>
        <p style="max-width: none;">
          <strong>Eingetragene Geschäftsführerin:</strong> Jeanna Gloor
        </p>
        <p style="max-width: none;">
          <strong>Gesellschaftsform:</strong> Gesellschaft mit beschränkter Haftung
        </p>
      </div>
    </div>
  </section>
</Layout>
