---
import { withBase } from '../utils/url';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { label: 'Startseite', path: '/' },
  { label: 'Preise', path: '/preise' },
  { label: 'Das SUN 400 XL', path: '/sun400xl' },
  { label: 'Das Studio', path: '/das-studio' },
  { label: 'Kontakt', path: '/kontakt' },
];

const isCurrent = (path: string) => {
  const norm = currentPath.replace(/\/$/, '') || '/';
  return norm === path;
};

const isHome = isCurrent('/');
---

<header class={`navbar${isHome ? ' navbar--over-hero' : ''}`} id="siteNavbar">
  <div class="navbar-shell">
    <nav class="nav-links" aria-label="Hauptnavigation">
      {navItems.map((item) => (
        <a href={withBase(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <a href={withBase('/')} class="logo" aria-label="Perfect Forms Studio Winterthur – Startseite">
      <span class="logo-text">
        <span class="logo-title">Perfect Forms</span>
        <span class="logo-subtitle">Studio Winterthur</span>
      </span>
    </a>

    <div class="nav-cta">
      <a href="tel:+41763833318" class="nav-phone" aria-label="Anrufen: 076 383 33 18">
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <span>076 383 33 18</span>
      </a>
      <a href={withBase('/kontakt')} class="nav-cta-btn">Probetraining</a>
    </div>

    <button
      class="mobile-menu-btn"
      id="mobileMenuBtn"
      type="button"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <svg class="icon-menu" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="icon-close" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="mobile-menu" id="mobileMenu" aria-label="Mobile Navigation">
    {navItems.map((item) => (
      <a href={withBase(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
    <a href="tel:+41763833318" class="mobile-menu-phone">076 383 33 18</a>
    <a href={withBase('/kontakt')} class="btn-primary">Probetraining buchen</a>
  </nav>
</header>
