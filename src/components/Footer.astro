---
import { withBase } from '../utils/url';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const footerLinks = [
  { label: 'Startseite', path: '/' },
  { label: 'Pakete & Abos', path: '/preise' },
  { label: 'Das SUN 400 XL', path: '/sun400xl' },
  { label: 'Das Studio', path: '/das-studio' },
  { label: 'Kontakt', path: '/kontakt' },
  { label: 'Häufige Fragen', path: '/#faq' },
  { label: 'Impressum', path: '/impressum' },
  { label: 'Datenschutz', path: '/datenschutz' },
];

const isCurrent = (path: string) => {
  const norm = currentPath.replace(/\/$/, '') || '/';
  return norm === path;
};
---

<footer class="footer">
  <div class="container footer-grid reveal-stagger">
    <div>
      <a href={withBase('/')} class="logo">
        <span class="logo-text">
          <span class="logo-title">Perfect Forms</span>
          <span class="logo-subtitle">Studio Winterthur</span>
        </span>
      </a>
      <p class="footer-about">
        Transformieren Sie Ihren Körper mit persönlicher Betreuung, Infrarot-Tiefenwärme und gezielter Bewegung in
        Winterthur.
      </p>
      <div class="footer-social">
        <a href="tel:+41763833318" class="footer-social-btn" aria-label="Anrufen: 076 383 33 18">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </a>
        <a href={withBase('/kontakt')} class="footer-social-btn" aria-label="Standort &amp; Anfahrt">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
        </a>
        <a href={withBase('/das-studio')} class="footer-social-btn" aria-label="Studio Galerie">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </svg>
        </a>
      </div>
    </div>

    <nav aria-label="Footer">
      <h2 class="footer-title">Seitenlinks</h2>
      <div class="footer-links">
        {footerLinks.map((link) => (
          <a href={withBase(link.path)} aria-current={isCurrent(link.path) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </div>
    </nav>

    <div>
      <h2 class="footer-title">Starten Sie Ihr Training</h2>
      <div class="footer-contact">
        <a href="tel:+41763833318" class="contact-item">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <div>
            <span>Rufen Sie uns gerne an</span>
            <strong>076 383 33 18</strong>
          </div>
        </a>
        <a href={withBase('/kontakt')} class="contact-item">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <div>
            <span>Standort Winterthur</span>
            <strong>Rychenbergstrasse 67 (Brauerei 67)</strong>
          </div>
        </a>
        <div class="contact-item">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <div>
            <strong>Mo–Fr | 13–20 Uhr</strong>
            <small>Termine nach Vereinbarung auch nach 18 Uhr und am Wochenende.</small>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="container footer-bottom reveal-up delay-200">
    &copy; 2026 Perfect Forms Studio Winterthur. Alle Rechte vorbehalten.
  </div>
</footer>
